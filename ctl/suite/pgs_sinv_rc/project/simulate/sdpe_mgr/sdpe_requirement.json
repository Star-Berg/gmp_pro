{
  "id": "pgs_sinv_rc_simulate",
  "macro_prefix": "PGS_SINV_RC_SIM",
  "display_name": "PGS SINV RC MATLAB/Simulink SIL",
  "description": "Windows SIL platform, plant and sensing settings for all SINV commissioning models.",
  "suite": "pgs_sinv_rc",
  "version": "1.0.0",
  "updated_at": "2026-07-23",
  "output_header": "sdpe_pgs_sinv_rc_simulate_settings.h",
  "hardware": [],
  "code_sections": {
    "after_extern_open": "#include <sdpe_pgs_sinv_rc_common_settings.h>\n#define SPECIFY_PC_ENVIRONMENT",
    "before_footer": "#if (BUILD_LEVEL < 1) || (BUILD_LEVEL > 6)\n#error BUILD_LEVEL_must_be_between_1_and_6\n#endif"
  },
  "feature_macros": [
    {
      "group": "SIL Runtime",
      "macro": "SINV_SIM_AUTO_ENABLE",
      "enabled": true,
      "weak": false,
      "value": "",
      "description": "Automatically request CiA402 ENABLE_OPERATION in the simulation executable."
    },
    {
      "group": "SIL Runtime",
      "macro": "SPECIFY_ENABLE_ADC_CALIBRATE",
      "enabled": false,
      "weak": false,
      "value": "",
      "description": "Simulated sensor ADC offsets are deterministic and do not require startup calibration."
    },
    {
      "group": "SIL Runtime",
      "macro": "ENABLE_GMP_DL_PIL_SIM",
      "enabled": false,
      "weak": false,
      "value": "",
      "description": "Use the native ASIO UDP SIL path instead of datalink PIL."
    }
  ],
  "option_macros": [
    {
      "group": "Commissioning",
      "macro": "BUILD_LEVEL",
      "enabled": true,
      "weak": false,
      "value": "(5)",
      "options_preset": "",
      "options": [
        "(1)",
        "(2)",
        "(3)",
        "(4)",
        "(5)",
        "(6)"
      ],
      "description": "1 open-loop R load; 2 current-loop R load; 3 grid current loop; 4 grid power loop; 5 DC-bus rectifier loop; 6 bidirectional grid mode."
    }
  ],
  "requirements": [
    {
      "role": "controller_frequency",
      "macro": "CONTROLLER_FREQUENCY",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "20e3"
      },
      "description": "SIL controller and PWM update frequency."
    },
    {
      "role": "pwm_frequency",
      "macro": "SINV_PWM_FREQUENCY_HZ",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "20e3"
      },
      "description": "Plant switching frequency."
    },
    {
      "role": "pwm_compare",
      "macro": "CTRL_PWM_CMP_MAX",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "2999"
      },
      "description": "Virtual PWM compare maximum."
    },
    {
      "role": "pwm_deadband",
      "macro": "CTRL_PWM_DEADBAND_CMP",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "50"
      },
      "description": "Virtual PWM deadband counts."
    },
    {
      "role": "adc_bits",
      "macro": "CTRL_ADC_RESOLUTION",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "12"
      },
      "description": "ADC resolution used by all sensor blocks."
    },
    {
      "role": "adc_reference",
      "macro": "CTRL_ADC_VOLTAGE_REF",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "3.3"
      },
      "description": "ADC reference voltage."
    },
    {
      "role": "dc_bus",
      "macro": "CTRL_DCBUS_VOLTAGE",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "80.0"
      },
      "description": "Rated and nominal DC-bus voltage."
    },
    {
      "role": "grid_rms",
      "macro": "CTRL_GRID_VOLTAGE_RMS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "36.0"
      },
      "description": "Nominal grid/load RMS voltage."
    },
    {
      "role": "current_rms",
      "macro": "CTRL_RATED_CURRENT_RMS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "10.0"
      },
      "description": "Rated RMS AC current."
    },
    {
      "role": "voltage_base",
      "macro": "CTRL_VOLTAGE_BASE",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "50.91"
      },
      "description": "Peak voltage PU base."
    },
    {
      "role": "current_base",
      "macro": "CTRL_CURRENT_BASE",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "14.14"
      },
      "description": "Peak current PU base."
    },
    {
      "role": "filter_l",
      "macro": "CTRL_AC_INDUCTANCE",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "480e-6"
      },
      "description": "AC filter series inductance."
    },
    {
      "role": "filter_l_esr",
      "macro": "CTRL_AC_RESISTANCE",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.10"
      },
      "description": "AC filter series resistance."
    },
    {
      "role": "filter_c",
      "macro": "SINV_FILTER_CAPACITANCE_F",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "22e-6"
      },
      "description": "AC filter shunt capacitance."
    },
    {
      "role": "filter_c_esr",
      "macro": "SINV_FILTER_CAP_ESR_OHM",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.10"
      },
      "description": "Filter capacitor ESR."
    },
    {
      "role": "load_r",
      "macro": "SINV_RLOAD_OHM",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "12.0"
      },
      "description": "Resistive load for levels 1 and 2."
    },
    {
      "role": "rectifier_load_r",
      "macro": "SINV_RECTIFIER_RLOAD_OHM",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "30.0"
      },
      "description": "DC-side load for level 5."
    },
    {
      "role": "dc_cap",
      "macro": "SINV_DC_CAPACITANCE_F",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "2200e-6"
      },
      "description": "DC-link capacitance."
    },
    {
      "role": "dc_voltage_gain",
      "macro": "CTRL_DC_VOLTAGE_SENSITIVITY",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.02705"
      },
      "description": "Generic half-bridge module DC voltage sensor sensitivity in V/V, used by DC bus and Buck voltage channels."
    },
    {
      "role": "dc_voltage_bias",
      "macro": "CTRL_DC_VOLTAGE_BIAS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.0"
      },
      "description": "DC bus voltage ADC bias."
    },
    {
      "role": "ac_voltage_gain",
      "macro": "CTRL_AC_VOLTAGE_SENSITIVITY",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.013559322"
      },
      "description": "AC/PCC voltage sensor sensitivity from the LC filter board voltage sense path."
    },
    {
      "role": "ac_voltage_bias",
      "macro": "CTRL_AC_VOLTAGE_BIAS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "1.65"
      },
      "description": "AC/PCC voltage ADC bias from the LC filter board voltage sense path."
    },
    {
      "role": "buck_output_voltage_sensitivity",
      "macro": "CTRL_BUCK_OUTPUT_VOLTAGE_SENSITIVITY",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.013559322"
      },
      "description": "Buck output-voltage sensing gain from the LC filter board voltage sense path. This is separate from CTRL_DC_VOLTAGE_SENSITIVITY because Vbus/Vin_buck still use the half-bridge DC bus sensor."
    },
    {
      "role": "buck_output_voltage_bias",
      "macro": "CTRL_BUCK_OUTPUT_VOLTAGE_BIAS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "1.65"
      },
      "description": "Buck output-voltage ADC bias from the LC filter board voltage sense path."
    },
    {
      "role": "ac_current_gain",
      "macro": "CTRL_AC_CURRENT_SENSITIVITY",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.150"
      },
      "description": "AC current sensor sensitivity in V/A."
    },
    {
      "role": "ac_current_bias",
      "macro": "CTRL_AC_CURRENT_BIAS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "1.65"
      },
      "description": "AC current ADC bias."
    },
    {
      "role": "current_limit",
      "macro": "CTRL_CURRENT_LIMIT_PU",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.9"
      },
      "description": "Peak current command limit in PU."
    },
    {
      "role": "p_slew",
      "macro": "CTRL_P_SLEW_PU_S",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "5.0"
      },
      "description": "Active-power command slew limit in PU/s."
    },
    {
      "role": "q_slew",
      "macro": "CTRL_Q_SLEW_PU_S",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "5.0"
      },
      "description": "Reactive-power command slew limit in PU/s."
    },
    {
      "role": "bus_ref",
      "macro": "SINV_DC_BUS_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "expr": "CTRL_DCBUS_VOLTAGE"
      },
      "description": "BUILD_LEVEL 5 physical DC bus voltage target. This aliases CTRL_DCBUS_VOLTAGE so the DC-bus target follows the platform DC-bus voltage setting."
    },
    {
      "role": "power_factor_q_sign",
      "macro": "SINV_POWER_FACTOR_Q_SIGN",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "-1.0"
      },
      "description": "BUILD_LEVEL 5 reactive-power direction for PF control. Use +1 or -1 to select the quadrature-current direction."
    },
    {
      "role": "buck_output_ref",
      "macro": "SINV_BUCK_OUTPUT_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "60.0"
      },
      "description": "Buck output voltage target."
    },
    {
      "role": "mosfet_ron",
      "macro": "SINV_MODEL_MOSFET_RON",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "4.6e-3"
      },
      "description": "Plant MOSFET on resistance."
