      "role": "protection_controller_max_pu",
      "macro": "CTRL_PROT_VCTRL_MAX_PU",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "1.5"
      },
      "description": "Maximum unsaturated modulation command before controller-divergence trip."
    },
    {
      "role": "dc_bus_ready_min",
      "macro": "CTRL_DCBUS_READY_MIN",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "((BUILD_LEVEL == 5) ? 25.0f : (CTRL_DCBUS_VOLTAGE * 0.8f))"
      },
      "description": "Minimum physical DC-bus voltage accepted by startup. BUILD_LEVEL 5 accepts passive precharge from the 24 Vrms grid; other build levels retain the 80 percent DC-bus requirement."
    },
    {
      "role": "dc_bus_ready_max",
      "macro": "CTRL_DCBUS_READY_MAX",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(CTRL_PROT_VBUS_MAX)"
      },
      "description": "Maximum physical DC-bus voltage accepted by the startup state machine."
    },
    {
      "role": "current_limit_pu",
      "macro": "CTRL_CURRENT_LIMIT_PU",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "0.6"
      },
      "description": "Peak current-reference limit in per unit."
    },
    {
      "role": "p_slew_pu_s",
      "macro": "CTRL_P_SLEW_PU_S",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "10.0"
      },
      "description": "Active-power command slew limit in PU/s."
    },
    {
      "role": "q_slew_pu_s",
      "macro": "CTRL_Q_SLEW_PU_S",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "20.0"
      },
      "description": "Reactive-power command slew limit in PU/s."
    },
    {
      "role": "power_factor_q_sign",
      "macro": "SINV_POWER_FACTOR_Q_SIGN",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "1.0"
      },
      "description": "BUILD_LEVEL 6 reactive-power direction for PF control. Use +1 or -1 to select the quadrature-current direction."
    },
    {
      "role": "adc_calibration_timeout",
      "macro": "TIMEOUT_ADC_CALIB_MS",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "3000"
      },
      "description": "ADC calibration timeout in ms."
    },
    {
      "role": "level6_grid_voltage_rms",
      "macro": "SINV_LEVEL7_GRID_VOLTAGE_RMS",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "24.0"
      },
      "description": "BUILD_LEVEL 7 grid RMS voltage reference used by the RMS protection window. This is a target/nominal value; the PLL still uses the measured grid voltage."
    },
    {
      "role": "level6_dc_bus_ref",
      "macro": "SINV_LEVEL7_DC_BUS_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "60.0"
      },
      "description": "BUILD_LEVEL 7 Boost target DC-bus voltage. In level 7 the DCDC stage regulates Vbus from the low-voltage input side."
    },
    {
      "role": "level6_boost_input_ref",
      "macro": "SINV_LEVEL7_BOOST_INPUT_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "48.0"
      },
      "description": "BUILD_LEVEL 7 nominal low-voltage DC source value feeding the Boost input side."
    },
    {
      "role": "level6_boost_vbus_slew",
      "macro": "SINV_LEVEL7_BOOST_VBUS_SLEW_V_S",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "120.0"
      },
      "description": "BUILD_LEVEL 7 Boost DC-bus reference soft-start slew rate in V/s."
    },
    {
      "role": "level6_boost_start_delay",
      "macro": "SINV_LEVEL7_BOOST_START_DELAY_MS",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "100"
      },
      "description": "BUILD_LEVEL 7 delay after the low-voltage Boost input is present and CiA402 is operation-enabled before Boost PWM starts."
    },
    {
      "role": "inverter_ready_stable_ms",
      "macro": "SINV_INVERTER_READY_STABLE_MS",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(100U)"
      },
      "description": "Time that all inverter READY conditions must remain valid."
    },
    {
      "role": "inverter_ready_vbus_tolerance",
      "macro": "SINV_INVERTER_READY_VBUS_TOLERANCE_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(1.0f)"
      },
      "description": "Allowed physical DC-bus voltage error before asserting inverter READY."
    },
    {
      "role": "startup_delay",
      "macro": "CTRL_STARTUP_DELAY",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "100"
      },
      "description": "Startup delay in ms."
    },
    {
      "role": "buck_output_ref",
      "macro": "SINV_BUCK_OUTPUT_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "float": "48.0"
      },
      "description": "Buck output voltage target."
    },
    {
      "role": "bus_ref",
      "macro": "SINV_DC_BUS_REF_V",
      "enabled": true,
      "weak": false,
      "binding": {
        "expr": "CTRL_DCBUS_VOLTAGE"
      },
      "description": "BUILD_LEVEL 5 physical DC bus voltage target. This aliases CTRL_DCBUS_VOLTAGE so the DC-bus target follows the platform DC-bus voltage setting."
    }
  ],
